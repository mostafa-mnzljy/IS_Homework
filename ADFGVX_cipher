def encrypt(text, matrix):
  symbols = "ADFGVX"
  result = ""

  for ch in text:
    if ch.isalnum():
        for row in range(6):
            if ch in matrix[row]:
              col = matrix[row].index(ch)
              result += symbols[row] + symbols[col]
              break
    else:
      result += ch

  return result
